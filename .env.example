# MotoMas — environment variables (Patch 3.0 production foundation)
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The `.env` file is required to run Prisma migrations, seed and the real
# database-backed features (login, user management, motorcycle inventory).

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://motomas:motomas@localhost:5432/motomas?schema=public"

# Secret used to sign the authentication session cookie (HMAC-SHA256).
# Generate a strong random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be identical across all server instances. Keep it out of source control.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional. When DATABASE_URL is NOT set, the app falls back to built-in
# development login accounts (documented in ROLES.md) only outside production
# so the demo keeps working offline. Set this to "false" to disable the dev
# fallback entirely.
# AUTH_DEV_FALLBACK="true"

# Required only when running `npx prisma db seed` for a production database and
# no Admin exists yet. The seed creates one bootstrap Admin from these values.
# If any value is missing, the seed prints a warning and does not create a user.
MOTOMAS_ADMIN_NAME="MotoMas Admin"
MOTOMAS_ADMIN_EMAIL="admin@example.com"
MOTOMAS_ADMIN_PASSWORD="change-me-before-seeding"

# Optional. Enables synthetic local demo records in browser localStorage readers
# outside production by default. Production builds default to empty initial
# records unless this is explicitly set to "true".
# NEXT_PUBLIC_MOTOMAS_ENABLE_DEMO_DATA="false"
