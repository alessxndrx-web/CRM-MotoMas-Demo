# MotoMas — environment variables (Patch 3.0 production foundation)
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The `.env` file is required to run Prisma migrations, seed and the real
# database-backed features (login, user management, motorcycle inventory).

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://motomas:motomas@localhost:5432/motomas?schema=public"

# Secret used to sign the authentication session cookie (HMAC-SHA256).
# REQUIRED IN PRODUCTION: with NODE_ENV=production the server throws on the first
# login/session check if this is missing. Outside production only, a built-in
# development key is used instead; that key is public and must never reach a
# deployed environment.
# Generate a strong random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be identical across all server instances. Keep it out of source control.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional. When DATABASE_URL is NOT set, the app falls back to built-in
# development login accounts (documented in ROLES.md) only outside production
# so the demo keeps working offline. Set this to "false" to disable the dev
# fallback entirely.
# AUTH_DEV_FALLBACK="true"

# Required only when running `npx prisma db seed` for a production database and
# no Admin exists yet. The seed creates one bootstrap Admin from these values.
# If any value is missing, the seed prints a warning and does not create a user.
MOTOMAS_ADMIN_NAME="MotoMas Admin"
MOTOMAS_ADMIN_EMAIL="admin@example.com"
MOTOMAS_ADMIN_PASSWORD="change-me-before-seeding"

# Optional. Enables synthetic local demo records in browser localStorage readers
# outside production by default. Production builds default to empty initial
# records unless this is explicitly set to "true".
# NEXT_PUBLIC_MOTOMAS_ENABLE_DEMO_DATA="false"

# --- Migration / hardening flags (Patch 3.7B–3.7E) -----------------------------
# All three default to OFF. In PRODUCTION they MUST stay unset (or "false").
# See src/shared/feature-flags.ts and docs/PRODUCTION_HARDENING_CHECKLIST.md.

# Reveals developer-only technical/migration wording (DB source badges,
# "pendiente de migración" dividers, DATABASE_URL notices). Keep hidden in prod.
# NEXT_PUBLIC_SHOW_TECHNICAL_MIGRATION_LABELS="false"

# Recovery-only switch that re-renders the legacy localStorage operational panels
# alongside the DB-backed ones. Migrated routes hide them when PostgreSQL is
# available; leave OFF in production so only DB-backed data is shown.
# NEXT_PUBLIC_ENABLE_LEGACY_OPERATIONAL_PANELS="false"

# Exposes the destructive browser-only "reset demo data" control in Settings.
# Never enable in production.
# NEXT_PUBLIC_ENABLE_DEMO_DATA_RESET="false"

# --- Integración con Meta (Patch Meta-1) ---------------------------------------
# Las tres son necesarias para operar el webhook de Meta Lead Ads
# (/api/webhooks/meta). Ninguna se guarda en la base de datos: se leen con
# process.env en el punto de uso. Ver docs/META_INTEGRATIONS.md para el paso a
# paso del panel de Meta.

# Clave secreta de la app de Meta (Meta App Dashboard → Configuración → Básica →
# "Clave secreta de la aplicación").
# OBLIGATORIA EN PRODUCCIÓN: con ella se verifica la firma X-Hub-Signature-256 de
# CADA entrega entrante. Sin ella el webhook rechaza todo con 401 — que es lo
# correcto: sin verificar la firma, cualquiera que descubra la URL podría
# inyectar leads falsos. Manténla fuera del control de versiones.
META_APP_SECRET="change-me-meta-app-secret"

# Cadena arbitraria que TÚ eliges y escribes en el panel de Meta al suscribir el
# webhook (Webhooks → "Token de verificación"). Sólo se usa en el saludo GET de
# suscripción; tiene que ser idéntica en los dos lados o Meta se niega a
# suscribir el webhook.
# Genera una fuerte, p. ej.:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
META_WEBHOOK_VERIFY_TOKEN="change-me-meta-verify-token"

# Token de página de larga duración (Graph API Explorer → página → permisos
# leads_retrieval + pages_show_list, luego canjéalo por uno de larga duración).
# Se usa para leer el nodo del lead en el Graph API: el payload del webhook NO
# trae el nombre, el teléfono ni el correo, sólo identificadores.
META_PAGE_ACCESS_TOKEN="change-me-meta-page-access-token"

# --- WhatsApp Cloud API (Patch Meta-2) -----------------------------------------
# Entra por el MISMO webhook que Lead Ads (/api/webhooks/meta) y por tanto usa el
# mismo META_APP_SECRET para verificar la firma. Estas dos son sólo para ENVIAR.
# Ninguna se guarda en la base de datos.

# Token del Usuario del Sistema con permisos whatsapp_business_messaging y
# whatsapp_business_management (Business Manager → Usuarios del sistema → Generar
# token). Usa un Usuario del Sistema, no un token personal: el personal caduca al
# cambiar la contraseña y deja de responder WhatsApp sin aviso.
WHATSAPP_ACCESS_TOKEN="change-me-whatsapp-access-token"

# Identificador NUMÉRICO que Meta asigna al número emisor — no es el número de
# teléfono. Está en WhatsApp Manager → API Setup → "Phone number ID".
# TODAVÍA NO ASIGNADO: el número real sigue pendiente de alta. Mientras esté
# vacío, todo intento de envío falla de forma explícita con
# "WHATSAPP_PHONE_NUMBER_ID no configurado" en vez de reventar; la recepción de
# mensajes entrantes no depende de esta variable y funciona igual.
WHATSAPP_PHONE_NUMBER_ID=""
