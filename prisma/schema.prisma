  NUEVO
  RECIBIDO
  EN_CLASIFICACION
  EN_PROGRESO
  PENDIENTE_USUARIO
  PENDIENTE_APROBACION
  ESCALADO_DESARROLLO
  ESCALADO_PROVEEDOR
  SOLUCION_PROPUESTA
  RESUELTO
  CERRADO
  REABIERTO
  CANCELADO
}

enum TicketPriority {
  P1_CRITICA
  P2_ALTA
  P3_MEDIA
  P4_BAJA
}

enum TicketImpact {
  CONSULTA
  AFECTA_UNA_TAREA
  IMPIDE_TRABAJAR
  AFECTA_VARIOS_USUARIOS
  SISTEMA_INDISPONIBLE
  RIESGO_SEGURIDAD
}

enum TicketCategory {
  ACCESO_Y_CUENTA
  ERROR_DEL_SISTEMA
  RENDIMIENTO
  DATOS_INCORRECTOS
  INVENTARIO
  TRASLADOS
  RESERVAS
  VENTAS
  EXPEDIENTES
  CREDITOS
  LEADS
  MARKETING
  REPORTES
  NOTIFICACIONES
  INTEGRACIONES
  SOLICITUD_DE_AYUDA
  SOLICITUD_DE_MEJORA
  SEGURIDAD
  OTRO
}

enum TicketScope {
  USER
  BRANCH
  MODULE
  GLOBAL
}

enum TicketCommentVisibility {
  PUBLIC
  INTERNAL
}

enum TicketParticipantType {
  CREATOR
  REQUESTER
  WATCHER
  ASSIGNEE
  APPROVER
  COLLABORATOR
}

enum MotorcycleUnitStatus {
  AVAILABLE
  RESERVED
  IN_TRANSFER
  SOLD
  DELIVERED
  EXITED
  CANCELLED
}

enum InventoryMovementType {
  INGRESO
  EGRESO
  RESERVA
  VENTA
  ENTREGA
  TRASLADO_SALIDA
  TRASLADO_ENTRADA
  AJUSTE
