// MotoMas — Production foundation schema (Patch 3.0)
//
// This schema is now the source of truth for the production database. It covers
// the entities delivered in Patch 3.0: branches, users (with real password
// hashes and role enum), the motorcycle catalog, individual motorcycle units,
// their inventory movements (ingress/egress) and a user audit log.
//
// The broader commercial CRM entities (leads, customers, files, reservations,
// sales, accounting, etc.) still run on browser localStorage in this phase and
// will be migrated in later patches — see DATABASE_PLAN.md and PRISMA_PLAN.md.
//
// Setup (requires a reachable PostgreSQL instance and DATABASE_URL):
//   npm run prisma:generate
//   npm run prisma:migrate     (npx prisma migrate dev --name init)
//   npm run prisma:seed        (node prisma/seed.mjs)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
  CAJERO
  CONTADOR
}

enum MotorcycleUnitStatus {
  AVAILABLE
  RESERVED
  IN_TRANSFER
  SOLD
  DELIVERED
  EXITED
  CANCELLED
}

enum InventoryMovementType {
  INGRESO
  EGRESO
  RESERVA
  VENTA
  ENTREGA
  TRASLADO_SALIDA
  TRASLADO_ENTRADA
  AJUSTE
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  motorcycleUnits  MotorcycleUnit[]
  inventoryMoves   InventoryMovement[]

  @@map("branches")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  branchId     String?  @map("branch_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  branch            Branch?             @relation(fields: [branchId], references: [id])
  createdMovements  InventoryMovement[] @relation("MovementCreatedBy")
  auditLogs         UserAuditLog[]      @relation("AuditActor")

  @@index([role])
  @@index([branchId])
  @@map("users")
}

model MotorcycleCatalogModel {
  id          String   @id @default(cuid())
  brand       String
  model       String
  slug        String   @unique
  year        Int?
  description String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  units MotorcycleUnit[]

  @@index([brand, model])
  @@map("motorcycle_catalog_models")
}

model MotorcycleUnit {
  id            String               @id @default(cuid())
  catalogModelId String?             @map("catalog_model_id")
  branchId      String               @map("branch_id")
  name          String
  brand         String
  model         String
  year          Int
  chassisNumber String               @unique @map("chassis_number")
  engineNumber  String?              @map("engine_number")
  color         String?
  entryDate     DateTime             @map("entry_date")
  exitDate      DateTime?            @map("exit_date")
  status        MotorcycleUnitStatus @default(AVAILABLE)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  catalogModel MotorcycleCatalogModel? @relation(fields: [catalogModelId], references: [id])
  branch       Branch                  @relation(fields: [branchId], references: [id])
  movements    InventoryMovement[]

  @@index([branchId, status])
  @@index([status])
  @@map("motorcycle_units")
}

model InventoryMovement {
  id               String                @id @default(cuid())
  motorcycleUnitId String                @map("motorcycle_unit_id")
  branchId         String                @map("branch_id")
  type             InventoryMovementType
  date             DateTime              @default(now())
  reason           String
  notes            String?
  createdByUserId  String                @map("created_by_user_id")
  createdAt        DateTime              @default(now()) @map("created_at")

  motorcycleUnit MotorcycleUnit @relation(fields: [motorcycleUnitId], references: [id])
  branch         Branch         @relation(fields: [branchId], references: [id])
  createdBy      User           @relation("MovementCreatedBy", fields: [createdByUserId], references: [id])

  @@index([motorcycleUnitId, date])
  @@index([branchId, date])
  @@map("inventory_movements")
}

model UserAuditLog {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@map("user_audit_logs")
}
